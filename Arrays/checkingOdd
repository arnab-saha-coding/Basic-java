class checkingOdd  {
    public static int countOdd(int[] arr, int n) {
        int count = 0;
        for (int i = 0; i < arr.length; i++) {
            if (arr[i] % 2 != 0) {
                count += 1;
            }
        }
        return count; 
    }

    public static void main(String[] args) {
        int arr[] = {1, 2, 3, 4, 5, 6};
        int n = arr.length;
        int okresult = countOdd(arr, n);

        System.out.println(okresult); 
    }
}
